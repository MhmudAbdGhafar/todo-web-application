{
  "info": {
    "name": "Todo App Microservices",
    "_postman_id": "6f7b8c9d-0000-1111-2222-333344445555",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "userBaseUrl", "value": "http://localhost:8081" },
    { "key": "todoBaseUrl", "value": "http://localhost:8082" },
    { "key": "email", "value": "mhmudabdghafar@gmail.com" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "User Service",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{userBaseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"Password123\"\n}"
            }
          }
        },
        {
          "name": "Activate",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{userBaseUrl}}/api/auth/activate?username={{email}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"123456\"\n}"
            }
          }
        },
        {
          "name": "Login (sets token var)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let json = pm.response.json();",
                  "pm.collectionVariables.set('token', json.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": "{{userBaseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"Password123\"\n}"
            }
          }
        },
        {
          "name": "Check Token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{userBaseUrl}}/api/auth/checkToken"
          }
        },
        {
          "name": "Forget Password (send OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{userBaseUrl}}/api/auth/forgetPassword"
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{userBaseUrl}}/api/auth/changePassword",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"otp\": \"123456\",\n  \"newPassword\": \"NewPassword123\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Todo Service",
      "item": [
        {
          "name": "Create Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{todoBaseUrl}}/api/items",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Gym\",\n  \"description\": \"do all gym activities\",\n  \"priority\": \"HIGH\",\n  \"status\": \"TODO\"\n}"
            }
          }
        },
        {
          "name": "Search by Title",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{todoBaseUrl}}/api/items?title=gym"
          }
        },
        {
          "name": "Get By Id",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{todoBaseUrl}}/api/items/1"
          }
        },
        {
          "name": "Update Item",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{todoBaseUrl}}/api/items/1",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"DONE\"\n}"
            }
          }
        },
        {
          "name": "Delete Item",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{todoBaseUrl}}/api/items/1"
          }
        }
      ]
    }
  ]
}